<?xml version='1.0'?>
<sdf version="1.9">
  <!--
    iris_with_vio_camera plus the extra sensors an estimator needs once GNSS
    can't be trusted: GNSS, magnetometer, barometer and a downward
    rangefinder. The camera, VIO IMU and ground truth are the same as in
    iris_with_vio_camera, which is left as it is so its recorded flights stay
    valid.

    All sensors are noise-free. Realistic noise and faults are added on replay
    by fault_injector.py, so changing the noise never means flying again.

    These sensors are for the estimator only. ArduPilot keeps its own
    simulated GPS, baro and compass inside SITL.

    The world must load the navsat, magnetometer and air-pressure systems and
    set spherical_coordinates (see iris_warehouse_vio_sensors.sdf).
  -->
  <model name="iris_with_vio_sensors">
    <include>
      <uri>model://iris_with_ardupilot</uri>
    </include>

    <!-- Forward camera for VIO, rigidly fixed, as in iris_with_vio_camera -->
    <link name='vio_camera_link'>
      <pose>0.1 0 -0.05 0 0 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>0.000001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000001</iyy>
          <iyz>0</iyz>
          <izz>0.000001</izz>
        </inertia>
      </inertial>
      <sensor name="vio_camera" type="camera">
        <pose>0 0 0 0 0 0</pose>
        <camera>
          <horizontal_fov>1.5708</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>L8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <topic>/vio/camera/image</topic>
      </sensor>
    </link>
    <joint name='vio_camera_joint' type='fixed'>
      <parent>iris_with_ardupilot::iris_with_standoffs::base_link</parent>
      <child>vio_camera_link</child>
    </joint>

    <!--
      Body-aligned sensor link at the base_link origin (x forward, y left,
      z up) carrying the VIO IMU, GNSS, magnetometer and barometer. Putting
      them at the origin keeps lever arms out of the way for now.
    -->
    <link name='vio_imu_link'>
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.000001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000001</iyy>
          <iyz>0</iyz>
          <izz>0.000001</izz>
        </inertia>
      </inertial>

      <sensor name="vio_imu" type="imu">
        <pose>0 0 0 0 0 0</pose>
        <always_on>1</always_on>
        <update_rate>200</update_rate>
        <topic>/vio/imu</topic>
      </sensor>

      <!-- GNSS: latitude, longitude, altitude and ENU velocity -->
      <sensor name="vio_gnss" type="navsat">
        <always_on>1</always_on>
        <update_rate>10</update_rate>
        <topic>/vio/gnss</topic>
      </sensor>

      <!-- Magnetometer: Earth's field in the body frame, tesla (the world
           sets the units and frame, see iris_warehouse_vio_sensors.sdf) -->
      <sensor name="vio_mag" type="magnetometer">
        <always_on>1</always_on>
        <update_rate>50</update_rate>
        <topic>/vio/mag</topic>
      </sensor>

      <!-- Barometer: static pressure in Pa, standard atmosphere for the
           sensor's height above the world origin taken as sea level (Gazebo
           ignores reference_altitude here). Only changes in height matter to
           the estimator, as with a real baro whose absolute pressure moves
           with the weather. -->
      <sensor name="vio_baro" type="air_pressure">
        <always_on>1</always_on>
        <update_rate>50</update_rate>
        <topic>/vio/baro</topic>
      </sensor>
    </link>
    <joint name='vio_imu_joint' type='fixed'>
      <parent>iris_with_ardupilot::iris_with_standoffs::base_link</parent>
      <child>vio_imu_link</child>
    </joint>

    <!--
      Downward rangefinder: one-beam gpu_lidar, same layout as
      iris_with_rangefinder. 0.10 m below base_link; the 0.12 m minimum skips
      the drone's own body, so it reads out of range when landed. 8 m max,
      about what a small lidar rangefinder gives indoors.
    -->
    <link name="vio_range_link">
      <pose>0 0 -0.10 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>1e-6</ixx>
          <iyy>1e-6</iyy>
          <izz>1e-6</izz>
        </inertia>
      </inertial>
      <sensor name="vio_range" type="gpu_lidar">
        <!-- pitch +90 deg points the beam (sensor +x) straight down -->
        <pose degrees="true">0 0 0 0 90 0</pose>
        <topic>/vio/range_scan</topic>
        <update_rate>20</update_rate>
        <always_on>1</always_on>
        <visualize>0</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.12</min>
            <max>8.0</max>
            <resolution>0.01</resolution>
          </range>
        </lidar>
      </sensor>
    </link>
    <joint name="vio_range_joint" type="fixed">
      <parent>iris_with_ardupilot::iris_with_standoffs::base_link</parent>
      <child>vio_range_link</child>
    </joint>

    <!-- Ground truth pose and velocity, for scoring -->
    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>iris_with_vio_sensors</robot_base_frame>
      <odom_publish_frequency>100</odom_publish_frequency>
      <odom_topic>/vio/ground_truth/odom</odom_topic>
      <dimensions>3</dimensions>
    </plugin>

  </model>
</sdf>
