<?xml version="1.0"?>
<model>
  <name>iris_with_vio_sensors</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>

  <description>
    iris_with_vio_camera plus noise-free GNSS (10 Hz), magnetometer (50 Hz),
    barometer (50 Hz) and a downward rangefinder (20 Hz) for multi-sensor
    estimation. Used by vin_autonomy.
  </description>
  <depend>
    <model>
      <uri>model://iris_with_ardupilot</uri>
      <version>1.0</version>
    </model>
  </depend>
</model>
