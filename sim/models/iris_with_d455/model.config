<?xml version="1.0"?>
<model>
  <name>iris_with_d455</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>

  <description>
    iris_with_ardupilot with a RealSense D455 stand-in (left IR camera
    640x360 at 30 Hz, 87 deg, and a 200 Hz IMU) on the realsense2_camera
    topic names, plus a downward rangefinder. Magnetometer, barometer and
    GNSS come from ArduPilot via MAVROS. Used by udl_nav_vin.
  </description>
  <depend>
    <model>
      <uri>model://iris_with_ardupilot</uri>
      <version>1.0</version>
    </model>
  </depend>
</model>
