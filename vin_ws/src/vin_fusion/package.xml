<?xml version="1.0"?>
<package format="3">
  <name>vin_fusion</name>
  <version>0.1.0</version>
  <description>ESKF fusing OpenVINS, IMU, GNSS, baro, mag and rangefinder</description>
  <maintainer email="hello@usefuldynamics.io">rick-dn</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
